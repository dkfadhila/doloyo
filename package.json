{
  "name": "motion-doll-studio",
  "private": true,
  "version": "0.5.0",
  "description": "Browser 3D pose and keyframe animation studio, local-first, drivable by AI agents over MCP",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "start": "node scripts/start.mjs",
    "dev": "vite",
    "prebuild": "node scripts/ensure-models.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 5173 --strictPort",
    "test": "vitest run",
    "setup": "npm install && npm run mcp:install && npm run mcp:build && npm run fetch-models",
    "mcp:install": "npm install --prefix mcp",
    "mcp:build": "npm run build --prefix mcp",
    "fetch-models": "node scripts/fetch-models.mjs",
    "examples": "vite-node scripts/make-examples.ts",
    "prepare-assets": "bash scripts/prepare-assets.sh"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "0.10.8",
    "@pixiv/three-vrm": "3.5.5",
    "@react-three/drei": "9.122.0",
    "@react-three/fiber": "8.17.10",
    "fflate": "0.8.3",
    "mp4-muxer": "5.2.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "three": "0.169.0",
    "webm-muxer": "5.0.3",
    "zustand": "4.5.5"
  },
  "devDependencies": {
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@gltf-transform/functions": "4.5.1",
    "@types/node": "22.9.0",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@types/three": "0.169.0",
    "@vitejs/plugin-react": "4.3.3",
    "sharp": "0.35.5",
    "typescript": "5.6.3",
    "vite": "5.4.10",
    "vitest": "2.1.4"
  }
}
